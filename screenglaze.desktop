[Desktop Entry]
NoDisplay=true
Type=Application
Name=Screenglaze
GenericName=Screenshot
GenericName[es]=Captura de pantalla
Comment=Screenshot sheet: share, save or crop
Comment[es]=Captura de pantalla: compartir, guardar o recortar
Exec=screenglaze
Icon=screenglaze
Terminal=false
Categories=Utility;Graphics;Qt;
Keywords=capture;screen;screenshot;crop;share;
Keywords[es]=captura;pantalla;screenshot;recortar;compartir;
# Hidden from the app drawer (NoDisplay). Screenshots are triggered by
# phone-keyconfig, which watches the buttons and calls shoot() on
# org.surya.Screenglaze over D-Bus; there is nothing for a launcher tile to do.
# The entry still exists so Plasma can tie the overlay window to an icon and a
# name, and so `screenglaze` from a terminal has a desktop id to answer to.
#
# Without StartupWMClass Plasma cannot tie the window to this entry: the id is
# built by Qt from QGuiApplication::setDesktopFileName(), so the two have to
# agree. (The overlay is a layer-shell surface and never appears in the task
# switcher anyway -- this matters for the launcher's own bookkeeping.)
StartupWMClass=screenglaze
